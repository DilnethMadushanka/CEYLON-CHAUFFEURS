rules_version = '2';

// Ceylon Chauffeurs - Firebase Storage rules (only needed if you enable Storage, Blaze plan).
// Anyone can view website images; only admins (listed in Firestore /admins) can upload.
service firebase.storage {
  match /b/{bucket}/o {
    match /site-images/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
